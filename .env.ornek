# Canlı sunucu ayarları. Bu dosyayı ".env" adıyla kopyalayıp değerleri doldurun.
# .env git'e girmez; gizli anahtarı kimseyle paylaşmayın.

# Gizli anahtar üretmek için:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=buraya-uretilen-anahtar
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=kullaniciadi.pythonanywhere.com
DJANGO_PROXY_ARKASINDA=1
